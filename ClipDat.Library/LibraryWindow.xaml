<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ClipDat.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDat Library">
    <Grid Background="#1D2228" RowDefinitions="Auto,Auto,*" Padding="22">
        <Grid ColumnDefinitions="*,360,Auto" ColumnSpacing="14" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="62" Height="62" Background="#263846" CornerRadius="12">
                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="29" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="Clip Library" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="Manage and share your saved clips." Foreground="#BCC6CE" />
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search clips..." VerticalAlignment="Center" TextChanged="OnFilterChanged" />
            <Button Grid.Column="2" Content="Choose folder" VerticalAlignment="Center" Click="OnChooseFolderClick" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,14">
            <ComboBox x:Name="TypeFilter" Width="142" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All media" />
                <ComboBoxItem Content="Clips" />
                <ComboBoxItem Content="Screenshots" />
                <ComboBoxItem Content="Favourites" />
            </ComboBox>
            <ComboBox x:Name="SortFilter" Grid.Column="1" Width="154" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Newest first" />
                <ComboBoxItem Content="Oldest first" />
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Largest first" />
            </ComboBox>
            <Button Grid.Column="2" Content="Refresh" Click="OnRefreshClick" />
            <Button x:Name="OpenFolderButton" Grid.Column="3" Content="Open folder" Click="OnOpenFolderClick" />
            <Button x:Name="DeleteSelectedButton" Grid.Column="4" Content="Delete selected" Click="OnDeleteSelectedClick" IsEnabled="False" />
            <TextBlock x:Name="CountText" Grid.Column="6" VerticalAlignment="Center" Foreground="#B5C0C9" />
            <TextBlock x:Name="SizeText" Grid.Column="7" VerticalAlignment="Center" Foreground="#B5C0C9" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="16">
            <Border Background="#252B32" CornerRadius="10" BorderBrush="#36414B" BorderThickness="1" Padding="12">
                <GridView x:Name="MediaGrid" SelectionMode="Multiple" IsItemClickEnabled="True"
                          ItemClick="OnItemClick" SelectionChanged="OnSelectionChanged"
                          ContainerContentChanging="OnContainerContentChanging">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="226" ItemHeight="192" /></ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="210" Height="176" Background="#20262D" CornerRadius="8"
                                    BorderBrush="#3B4550" BorderThickness="1" Padding="8" RightTapped="OnItemRightTapped" DoubleTapped="OnItemDoubleTapped">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open file" Click="OnOpenFileClick" />
                                        <MenuFlyoutItem Text="Rename" Click="OnRenameClick" />
                                        <MenuFlyoutItem Text="Favourite / Unfavourite" Click="OnFavouriteClick" />
                                        <MenuFlyoutItem Text="Copy file" Click="OnCopyFileClick" />
                                        <MenuFlyoutItem Text="Copy file path" Click="OnCopyPathClick" />
                                        <MenuFlyoutItem Text="Show in folder" Click="OnShowFileClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Click="OnDeleteSelectedClick" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel Spacing="5">
                                    <Grid Height="112" Background="#151A1E">
                                        <FontIcon Glyph="&#xE714;" FontSize="27" Foreground="#7E8C98" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#AFBAC3" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>
            <Border Grid.Column="1" Background="#252B32" CornerRadius="10" BorderBrush="#36414B" BorderThickness="1" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="13">
                        <TextBlock Text="Selected file" FontSize="18" FontWeight="SemiBold" />
                        <MediaPlayerElement x:Name="VideoPlayer" Height="215" AreTransportControlsEnabled="True" Visibility="Collapsed" />
                        <Image x:Name="PhotoPreview" Height="215" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBlock x:Name="EmptySelectionText" Text="Choose a clip or screenshot to preview it." Foreground="#B7C1C9" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedNameText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedDetailsText" Foreground="#B7C1C9" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button x:Name="OpenSelectedButton" Content="Open file" Click="OnOpenFileClick" IsEnabled="False" />
                            <Button x:Name="ShowSelectedButton" Grid.Column="1" Content="Show in folder" Click="OnShowFileClick" IsEnabled="False" />
                        </Grid>
                        <TextBlock Text="Description" />
                        <TextBox x:Name="DescriptionBox" PlaceholderText="Add a description..." AcceptsReturn="True" Height="70" TextChanged="OnMetadataEdited" />
                        <TextBlock Text="Tags (comma separated)" />
                        <TextBox x:Name="TagsBox" PlaceholderText="Add tags..." TextChanged="OnMetadataEdited" />
                        <Button x:Name="FavouriteButton" Content="Add to favourites" HorizontalAlignment="Left" Click="OnFavouriteClick" IsEnabled="False" />
                        <TextBlock Text="Direct sharing unavailable" FontWeight="SemiBold" />
                        <TextBlock Text="A public HTTPS link has not been verified. Copy Link stays unavailable; local files are never uploaded." TextWrapping="Wrap" Foreground="#B7C1C9" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
