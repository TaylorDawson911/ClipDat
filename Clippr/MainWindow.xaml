<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clippr.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clippr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ClipDat">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="40,72,*" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22272D" Offset="0" />
                <GradientStop Color="#1C1E21" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <Style x:Key="SegmentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AudioMuteButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="4*,6*" Background="#202020">
            <Border Grid.Column="0" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2E98F0" Offset="0" />
                        <GradientStop Color="#002E98F0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackToCaptureButton" Visibility="Collapsed" Width="36" Height="32"
                        Margin="6,0,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                        CornerRadius="5" Click="OnBackToCaptureClick"
                        ToolTipService.ToolTip="Back to capture" AutomationProperties.Name="Back to capture">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                </Button>
                <Image Source="ms-appx:///Assets/ClipDatMark.png" Width="20" Height="20"
                       Margin="16,0,0,0" VerticalAlignment="Center" Stretch="Uniform"
                       AutomationProperties.Name="ClipDat logo" />
                <TextBlock x:Name="WindowTitleText" Text="ClipDat" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="46" Height="32" Padding="0"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    CornerRadius="0"
                    UseSystemFocusVisuals="False"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" />
            </Button>
        </Grid>
        <Border x:Name="CaptureToolbar" Grid.Row="1" Background="#292B2E" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Text="Capture source" VerticalAlignment="Center" FontSize="15" Foreground="#D3D7DA" />
                <Border x:Name="CaptureSourceGroup" Width="280" Height="42" CornerRadius="7"
                        BorderBrush="#555555" BorderThickness="1" Background="#252525">
                    <Grid ColumnDefinitions="*,*">
                        <Border x:Name="SourceSelectionIndicator" Grid.Column="0" Grid.ColumnSpan="2"
                                Width="137" Margin="1" HorizontalAlignment="Left" CornerRadius="6"
                                Background="#424242" IsHitTestVisible="False" />
                        <Border x:Name="SourceHoverIndicator" Grid.Column="0" Grid.ColumnSpan="2"
                                Width="137" Margin="1" HorizontalAlignment="Left" CornerRadius="6"
                                Background="#565656" Opacity="0" IsHitTestVisible="False" />
                        <Button x:Name="ScreenSourceButton" Grid.Column="0" Style="{StaticResource SegmentButtonStyle}"
                                Click="OnScreenSourceClick" PointerEntered="OnScreenSourcePointerEntered"
                                PointerExited="OnSourcePointerExited"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="6,0,0,6"
                                Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                                <TextBlock Text="Screen" VerticalAlignment="Center" FontSize="15" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ApplicationSourceButton" Grid.Column="1" Style="{StaticResource SegmentButtonStyle}"
                                Click="OnApplicationSourceClick" PointerEntered="OnApplicationSourcePointerEntered"
                                PointerExited="OnSourcePointerExited"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" CornerRadius="0,6,6,0"
                                Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="18" Height="16" VerticalAlignment="Center">
                                    <Border BorderBrush="#D3D7DA" BorderThickness="1.4" CornerRadius="2" />
                                    <Border Height="1" Background="#D3D7DA" VerticalAlignment="Top" Margin="1,4,1,0" />
                                </Grid>
                                <TextBlock Text="Application" VerticalAlignment="Center" FontSize="15" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock x:Name="SourceLabel" Text="Display" VerticalAlignment="Center" FontSize="15" Foreground="#D3D7DA" />
                <Button x:Name="DisplayPickerButton" Width="210" Height="42"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,0" FontSize="15"
                        AutomationProperties.Name="Display">
                    <Button.Content>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="DisplayLabel" Grid.Column="0" Text="Finding displays" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                      Foreground="#BFC5C9" VerticalAlignment="Center" />
                        </Grid>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout x:Name="DisplayFlyout" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="CaptureContent" Grid.Row="2" Margin="18,14,18,16" RowDefinitions="*,Auto,Auto" RowSpacing="18">
            <Border x:Name="PreviewFrame" Grid.Row="0" MinHeight="180"
                    Background="#101010" BorderBrush="#5C6974" BorderThickness="1" CornerRadius="12" Padding="1">
                <Grid>
                    <SwapChainPanel x:Name="PreviewPanel" SizeChanged="OnPreviewSizeChanged" />
                    <Border x:Name="PreviewOverlay" Background="#202020" CornerRadius="10">
                        <TextBlock x:Name="PreviewMessage" Text="Starting screen capture"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#D3D7DA" FontSize="15" />
                    </Border>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Spacing="6" MaxWidth="750">
                        <Border x:Name="InfoBanner" Visibility="Collapsed" Padding="10,7"
                                Background="#E0262023" BorderBrush="#BA4B51" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="#EE6670" VerticalAlignment="Center" />
                                <TextBlock x:Name="InfoMessage" VerticalAlignment="Center" Foreground="White"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                <HyperlinkButton x:Name="FixNowButton" Content="Fix now" Padding="5,0"
                                                 Foreground="#A6D7F4" Click="OnFixNowClick" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,7" Background="#D91A1F22" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReplayMessage" Text="Replay starting…" VerticalAlignment="Center"
                                           Foreground="#F0F3F5" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="EncodingMessage" Text="" VerticalAlignment="Center"
                                           Foreground="#C1C9CE" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="SavedFileActionsButton" Content="Saved file actions" Visibility="Collapsed"
                                        Height="28" Padding="8,0" FontSize="12">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open File" Click="OnOpenSavedFileClick" />
                                            <MenuFlyoutItem Text="Show in Folder" Click="OnShowSavedFileClick" />
                                            <MenuFlyoutItem Text="Copy File Path" Click="OnCopySavedPathClick" />
                                            <MenuFlyoutItem Text="Copy File" Click="OnCopySavedFileClick" />
                                            <MenuFlyoutItem x:Name="ShareClipMenuItem" Text="Share Clip…" Visibility="Collapsed" Click="OnShareClipClick" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="OpenClipsButton" Content="Open Clips" Height="28"
                                        Padding="8,0" FontSize="12" Click="OnOpenClipsClick" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SharingStatusText" Visibility="Collapsed" MaxWidth="750"
                                   Foreground="#C1C9CE" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiagnosticsMessage" Visibility="Collapsed" MaxWidth="750"
                                   Foreground="#BFC8D0" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="HotkeyHintBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                            Padding="8,5" Background="#C91A1F22" CornerRadius="5">
                        <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Shift + F10"
                                   Foreground="#CDD4D9" FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#414141" BorderThickness="1"
                    CornerRadius="12" Padding="16,10">
                <Border.Resources>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#77BDF4" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#91CAFA" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#4B9DE1" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2E98F0" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#4AA8F5" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#237CC4" />
                </Border.Resources>
                <StackPanel Spacing="4">
                    <Grid Height="44" ColumnDefinitions="185,36,*,64" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Desktop" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="DesktopMuteButton" Grid.Column="1" Style="{StaticResource AudioMuteButtonStyle}" Click="OnAudioMuteClick">
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                        </Button>
                        <Grid x:Name="DesktopMeterTrack" Grid.Column="2">
                            <Border x:Name="DesktopMeter" Height="3" Margin="12,7,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="2" IsHitTestVisible="False" />
                            <Slider x:Name="DesktopVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1" ValueChanged="OnAudioVolumeChanged" />
                        </Grid>
                        <TextBlock x:Name="DesktopVolumeLabel" Grid.Column="3" Text="100%" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Height="44" ColumnDefinitions="185,36,*,64" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Microphone" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="MicrophoneMuteButton" Grid.Column="1" Style="{StaticResource AudioMuteButtonStyle}" Click="OnAudioMuteClick">
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                        </Button>
                        <Grid x:Name="MicrophoneMeterTrack" Grid.Column="2">
                            <Border x:Name="MicrophoneMeter" Height="3" Margin="12,7,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="2" IsHitTestVisible="False" />
                            <Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1" ValueChanged="OnAudioVolumeChanged" />
                        </Grid>
                        <TextBlock x:Name="MicrophoneVolumeLabel" Grid.Column="3" Text="100%" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="AdditionalAudioContainer" Height="0" VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden">
                      <StackPanel x:Name="AdditionalAudioSources" Spacing="4" Opacity="0">
                        <Grid Height="44" ColumnDefinitions="185,36,*,64" ColumnSpacing="10">
                            <Grid Grid.Column="0" ColumnDefinitions="30,*" VerticalAlignment="Center">
                                <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="GameAudioPicker" Grid.Column="1" Height="30" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="OnAudioApplicationChanged" />
                            </Grid>
                            <Button x:Name="GameMuteButton" Grid.Column="1" Style="{StaticResource AudioMuteButtonStyle}" Click="OnAudioMuteClick">
                                <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                            </Button>
                            <Grid x:Name="GameMeterTrack" Grid.Column="2">
                                <Border x:Name="GameMeter" Height="3" Margin="12,7,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="2" IsHitTestVisible="False" />
                                <Slider x:Name="GameVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1" ValueChanged="OnAudioVolumeChanged" />
                            </Grid>
                            <TextBlock x:Name="GameVolumeLabel" Grid.Column="3" Text="100%" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="44" ColumnDefinitions="185,36,*,64" ColumnSpacing="10">
                            <Grid Grid.Column="0" ColumnDefinitions="30,*" VerticalAlignment="Center">
                                <FontIcon Grid.Column="0" Glyph="&#xE8F2;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="ChatAudioPicker" Grid.Column="1" Height="30" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="OnAudioApplicationChanged" />
                            </Grid>
                            <Button x:Name="ChatMuteButton" Grid.Column="1" Style="{StaticResource AudioMuteButtonStyle}" Click="OnAudioMuteClick">
                                <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                            </Button>
                            <Grid x:Name="ChatMeterTrack" Grid.Column="2">
                                <Border x:Name="ChatMeter" Height="3" Margin="12,7,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="2" IsHitTestVisible="False" />
                                <Slider x:Name="ChatVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1" ValueChanged="OnAudioVolumeChanged" />
                            </Grid>
                            <TextBlock x:Name="ChatVolumeLabel" Grid.Column="3" Text="100%" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="44" ColumnDefinitions="185,36,*,64" ColumnSpacing="10">
                            <Grid Grid.Column="0" ColumnDefinitions="30,*" VerticalAlignment="Center">
                                <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ComboBox x:Name="MusicAudioPicker" Grid.Column="1" Height="30" FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="OnAudioApplicationChanged" />
                            </Grid>
                            <Button x:Name="MusicMuteButton" Grid.Column="1" Style="{StaticResource AudioMuteButtonStyle}" Click="OnAudioMuteClick">
                                <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                            </Button>
                            <Grid x:Name="MusicMeterTrack" Grid.Column="2">
                                <Border x:Name="MusicMeter" Height="3" Margin="12,7,12,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="2" IsHitTestVisible="False" />
                                <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1" ValueChanged="OnAudioVolumeChanged" />
                            </Grid>
                            <TextBlock x:Name="MusicVolumeLabel" Grid.Column="3" Text="100%" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="AdditionalSourcesButton" Height="38" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Padding="12,0" CornerRadius="10"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" Click="OnAdditionalSourcesClick"
                            AutomationProperties.Name="Show additional audio sources">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <FontIcon x:Name="AdditionalSourcesChevron" Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                            <TextBlock x:Name="AdditionalSourcesLabel" Text="Show additional audio sources" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12" MinHeight="48">
                <Button x:Name="ClippingButton" Grid.Column="0" Height="48"
                        HorizontalAlignment="Stretch" Click="OnClippingClick"
                        Background="#A94349" Foreground="White" BorderBrush="#BE555B" CornerRadius="8" FontSize="15">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon x:Name="ClippingButtonIcon" Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="21" />
                        <TextBlock x:Name="ClippingButtonLabel" Text="Stop clipping" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScreenshotButton" Grid.Column="1" Height="48"
                        HorizontalAlignment="Stretch" Click="OnScreenshotClick"
                        Background="#343A40" Foreground="White" BorderBrush="#59636C" BorderThickness="1" CornerRadius="8" FontSize="15"
                        ToolTipService.ToolTip="Take a screenshot · Ctrl + Alt + F10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="19" />
                        <TextBlock Text="Screenshot" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveReplayButton" Grid.Column="2" Height="48"
                        HorizontalAlignment="Stretch" Click="OnSaveReplayClick"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="8" FontSize="15"
                        Background="#527F9E" Foreground="White" BorderBrush="#658EAA"
                        ToolTipService.ToolTip="Save replay">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="21" />
                        <TextBlock Text="Save clip" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />

    </Grid>
</Window>
