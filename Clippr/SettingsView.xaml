                        <Grid ColumnDefinitions="58,*" ColumnSpacing="16">
                            <Border Width="58" Height="58" CornerRadius="14" Background="#263C55" BorderBrush="#3F6589" BorderThickness="1"><FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="White" /></Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="Audio" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Choose real WASAPI devices and independent sources for your clips." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </Grid>
                        <Grid x:Name="AudioCardsGrid" ColumnDefinitions="*,*,0" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <StackPanel x:Name="AudioLeftCards" Spacing="16">
                                <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border Width="44" Height="44" Background="#273039" CornerRadius="9"><FontIcon Glyph="&#xE7F4;" FontSize="21" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Desktop audio" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Capture system audio from speakers and applications." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><ToggleSwitch x:Name="DesktopAudioCheck" Grid.Column="2" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Capture desktop output" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Output device" VerticalAlignment="Center" /><ComboBox x:Name="OutputDeviceCombo" AutomationProperties.Name="Output audio device" Grid.Column="1" HorizontalAlignment="Stretch" /><Button Grid.Column="2" Content="↻" Click="OnRefreshAudioDevicesClick" AutomationProperties.Name="Refresh output devices" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Signal peak" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel x:Name="DesktopPreviewMeter" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" /><TextBlock x:Name="DesktopPreviewLevel" Grid.Column="2" Text="—" MinWidth="52" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                    <TextBlock Text="Desktop capture can include games, music and other applications." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12"><Border Width="44" Height="44" Background="#273039" CornerRadius="9"><FontIcon Glyph="&#xE720;" FontSize="21" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Microphone" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Capture your microphone audio." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><ToggleSwitch x:Name="MicrophoneCheck" Grid.Column="2" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Capture microphone" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Input device" VerticalAlignment="Center" /><ComboBox x:Name="InputDeviceCombo" AutomationProperties.Name="Microphone input device" Grid.Column="1" HorizontalAlignment="Stretch" /><Button Grid.Column="2" Content="↻" Click="OnRefreshAudioDevicesClick" AutomationProperties.Name="Refresh microphone devices" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Input volume" VerticalAlignment="Center" /><Slider x:Name="SettingsMicrophoneVolumeSlider" AutomationProperties.Name="Microphone input volume" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="1" ValueChanged="OnSettingsMicrophoneVolumeChanged" /><TextBlock x:Name="SettingsMicrophoneVolumeText" Grid.Column="2" Text="100%" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" /></Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock x:Name="MicrophoneTestStatus" Text="Use Test microphone to check the captured signal." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Test microphone" Click="OnTestMicrophoneClick" /></Grid>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="AudioRightCards" Grid.Column="1" Spacing="16">
                                <Border x:Name="AdvancedApplicationAudioCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed"><StackPanel Spacing="14">
                                    <StackPanel><TextBlock Text="Application audio" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Capture audio from specific applications on separate tracks." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Game audio" VerticalAlignment="Center" /><ComboBox x:Name="GameAudioCombo" AutomationProperties.Name="Game audio application" Grid.Column="1" HorizontalAlignment="Stretch" /><Button Grid.Column="2" Content="↻" Click="OnRefreshAudioApplicationsClick" AutomationProperties.Name="Refresh game applications" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Discord audio" VerticalAlignment="Center" /><ComboBox x:Name="DiscordAudioCombo" AutomationProperties.Name="Chat audio application" Grid.Column="1" HorizontalAlignment="Stretch" /><Button Grid.Column="2" Content="↻" Click="OnRefreshAudioApplicationsClick" AutomationProperties.Name="Refresh chat applications" /></Grid>
                                    <TextBlock Text="Process sources are saved on separate tracks. They replace desktop mixing to prevent duplicate audio. Windows 10 build 20348 or newer is required." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="13">
                                    <StackPanel><TextBlock Text="Audio preview" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Captured signal peaks in real time (dBFS)." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Desktop audio" /><StackPanel x:Name="PreviewDesktopMeter" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" /><TextBlock x:Name="PreviewDesktopLevel" Grid.Column="2" Text="—" MinWidth="52" TextAlignment="Right" FontSize="12" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Microphone" /><StackPanel x:Name="PreviewMicrophoneMeter" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" /><TextBlock x:Name="PreviewMicrophoneLevel" Grid.Column="2" Text="—" MinWidth="52" TextAlignment="Right" FontSize="12" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Game audio" /><StackPanel x:Name="PreviewGameMeter" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" /><TextBlock x:Name="PreviewGameLevel" Grid.Column="2" Text="—" MinWidth="52" TextAlignment="Right" FontSize="12" /></Grid>
                                    <Grid ColumnDefinitions="105,*,Auto" ColumnSpacing="8"><TextBlock Text="Chat audio" /><StackPanel x:Name="PreviewChatMeter" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" /><TextBlock x:Name="PreviewChatLevel" Grid.Column="2" Text="—" MinWidth="52" TextAlignment="Right" FontSize="12" /></Grid>
                                </StackPanel></Border>
                            </StackPanel>
                            <Border x:Name="AudioBehaviourCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Audio behaviour" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Process audio replaces the desktop mix when selected, preventing duplicate sound without altering track levels." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="AudioAvailabilityText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="OutputPage" Grid.Row="1" Margin="24,20,8,14" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="16">
                            <Border Width="58" Height="58" CornerRadius="14" Background="#263C55" BorderBrush="#3F6589" BorderThickness="1">
                                <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Output" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="Configure how ClipDat saves your clips, replays and screenshots." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OutputCardsGrid" ColumnDefinitions="1.15*,*,0" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <StackPanel x:Name="OutputLeftCards" Spacing="16">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="3"><TextBlock Text="Storage location" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Choose where your clips and screenshots are saved." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Clip folder" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox x:Name="ClipFolderBox" AutomationProperties.Name="Clip folder" />
                                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolderClick" />
                                            </Grid>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="Clips are saved here. Screenshots go in its Screenshots subfolder." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Open folder" Click="OnOpenOutputFolderClick" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="40"><TextBlock Text="Show Clip Library" VerticalAlignment="Center" /><ToggleSwitch x:Name="LibraryEnabledCheck" Grid.Column="1" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Show Clip Library" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="13">
                                        <StackPanel Spacing="3"><TextBlock Text="Replay clips" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Settings for Save Clip and replay exports." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3"><TextBlock Text="Clip length" VerticalAlignment="Center" /><ComboBox x:Name="ClipLengthCombo" AutomationProperties.Name="Clip length" Grid.Column="1" HorizontalAlignment="Stretch" /><TextBlock Grid.Row="1" Grid.Column="1" Text="How much recent footage Save Clip requests." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                        <Grid x:Name="CustomLengthRow" ColumnDefinitions="135,*" ColumnSpacing="12" Visibility="Collapsed"><TextBlock Text="Custom seconds" VerticalAlignment="Center" /><NumberBox x:Name="CustomLengthBox" Grid.Column="1" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" /></Grid>
                                        <Grid x:Name="AdvancedReplayMemoryRow" ColumnDefinitions="135,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3" Visibility="Collapsed"><TextBlock Text="Replay memory limit" TextWrapping="Wrap" VerticalAlignment="Center" /><ComboBox x:Name="ReplayMemoryCombo" AutomationProperties.Name="Replay memory limit" Grid.Column="1" HorizontalAlignment="Stretch" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Maximum RAM used for the replay buffer." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                        <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3"><TextBlock Text="Quality preset" VerticalAlignment="Center" /><ComboBox x:Name="QualityCombo" AutomationProperties.Name="Quality preset" Grid.Column="1" HorizontalAlignment="Stretch" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Higher quality uses more disk space." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                        <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3"><TextBlock Text="Video format" VerticalAlignment="Center" /><ComboBox x:Name="VideoFormatCombo" AutomationProperties.Name="Replay video format" Grid.Column="1" HorizontalAlignment="Stretch" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Replay exports use this format; direct recordings use MP4." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="13">
                                        <StackPanel Spacing="3"><TextBlock Text="Screenshots" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Settings for screenshot captures." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="40"><TextBlock Text="Enable screenshots" VerticalAlignment="Center" /><ToggleSwitch x:Name="ScreenshotsEnabledCheck" Grid.Column="1" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Enable screenshots" /></Grid>
                                        <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3"><TextBlock Text="Image format" VerticalAlignment="Center" /><ComboBox x:Name="ScreenshotFormatCombo" AutomationProperties.Name="Screenshot image format" Grid.Column="1" HorizontalAlignment="Stretch" /><TextBlock Grid.Row="1" Grid.Column="1" Text="PNG is lossless; JPEG uses adjustable quality." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                        <Grid x:Name="ScreenshotJpegQualityRow" ColumnDefinitions="135,*" ColumnSpacing="12" Visibility="Collapsed"><TextBlock Text="JPEG quality" VerticalAlignment="Center" /><NumberBox x:Name="ScreenshotJpegQualityBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" /></Grid>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="40"><StackPanel VerticalAlignment="Center"><TextBlock Text="Copy screenshot to clipboard" TextWrapping="Wrap" /><TextBlock Text="Automatically copy saved screenshots." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch x:Name="CopyScreenshotCheck" Grid.Column="1" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Copy screenshot to clipboard" /></Grid>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="40"><TextBlock Text="Play a sound after a screenshot is saved" TextWrapping="Wrap" VerticalAlignment="Center" /><ToggleSwitch x:Name="ScreenshotSoundCheck" Grid.Column="1" OnContent="" OffContent="" Width="52" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Play a sound after a screenshot is saved" /></Grid>
                                        <Grid ColumnDefinitions="135,*" ColumnSpacing="12"><TextBlock Text="Screenshot hotkey" VerticalAlignment="Center" /><ComboBox x:Name="ScreenshotHotkeyCombo" AutomationProperties.Name="Screenshot hotkey" Grid.Column="1" HorizontalAlignment="Stretch" /></Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="OutputRightCards" Grid.Column="1" Spacing="16">
                                <Border Style="{StaticResource SettingsCardStyle}">
