<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Clippr.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="VoiceCommandRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#242B32" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="VoiceCommandGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#20262D" />
            <Setter Property="BorderBrush" Value="#39424B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="BehaviourToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="50" Height="28">
                            <Border x:Name="Track" Width="50" Height="26" CornerRadius="13" Background="#242A31"
                                    BorderBrush="#9BA6B1" BorderThickness="1" VerticalAlignment="Center" />
                            <Ellipse x:Name="Knob" Width="20" Height="20" Margin="3,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Fill="#C5CDD5" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Track.Background" Value="#2E98F0" />
                                            <Setter Target="Track.BorderBrush" Value="#2E98F0" />
                                            <Setter Target="Knob.Fill" Value="White" />
                                            <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VoicePhraseEditorStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" IsTabStop="False" />
                            <Border Height="1" Background="#2E98F0" VerticalAlignment="Bottom" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left" OpenPaneLength="225" CompactPaneLength="48" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="OnNavigationSelectionChanged"
                    Background="#21252A" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,18,12,20" Spacing="3">
                <TextBlock Text="ClipDat" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="SETTINGS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Capture" Tag="Capture">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Voice Control" Tag="Voice">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Audio" Tag="Audio">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Output" Tag="Output">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Quick Share" Tag="QuickShare">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Feedback" Tag="Feedback">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel>
                <HyperlinkButton x:Name="OpenClipsFolderLink" Click="OnOpenClipsFolderClick" HorizontalAlignment="Left"
                                 Margin="12,0,0,10" Padding="8,6" Foreground="#C9D3DC" AutomationProperties.Name="Open Clips Folder">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        <TextBlock Text="Open Clips Folder" FontSize="13" />
                    </StackPanel>
                </HyperlinkButton>
                <Border Height="68" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,52" Margin="20,0,16,0">
                        <TextBlock Text="Advanced Settings" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch x:Name="AdvancedToggle" Grid.Column="1" OnContent="" OffContent=""
                                      Width="52" VerticalAlignment="Center" Toggled="OnAdvancedToggled"
                                      AutomationProperties.Name="Show advanced settings" />
                    </Grid>
                </Border>
            </StackPanel>
        </NavigationView.PaneFooter>
        <NavigationView.Content>
            <Grid x:Name="SettingsPages" RowDefinitions="Auto,*,Auto">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#242A30" Offset="0" />
                        <GradientStop Color="#1E2023" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Grid.Row="0" Margin="24,16,24,0" Spacing="4">
                    <AutoSuggestBox x:Name="SettingsSearchBox" MaxWidth="480" HorizontalAlignment="Stretch"
                                    PlaceholderText="Search settings…" QueryIcon="Find" AutomationProperties.Name="Search settings"
                                    TextChanged="OnSettingsSearchTextChanged" SuggestionChosen="OnSettingsSearchSuggestionChosen"
                                    QuerySubmitted="OnSettingsSearchQuerySubmitted" />
                    <TextBlock x:Name="SettingsSearchEmptyText" Text="No matching settings." FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
                <ScrollViewer x:Name="CapturePage" Grid.Row="1" Margin="24,20,8,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Width="58" Height="58" CornerRadius="14" Background="#263C55" BorderBrush="#3F6589" BorderThickness="1" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Capture" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="Choose what ClipDat captures and how recordings are encoded." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="13">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Capture source" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Select what to capture and where." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid x:Name="CaptureSourceGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Width="48" Height="54" CornerRadius="10" Background="#2B3138" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="Capture mode" FontSize="13" FontWeight="SemiBold" />
                                            <ComboBox x:Name="CaptureModeCombo" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="What to capture." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="CaptureDisplayField" Grid.Column="1" ColumnDefinitions="48,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Width="48" Height="54" CornerRadius="10" Background="#2B3138" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="Display" FontSize="13" FontWeight="SemiBold" />
                                            <ComboBox x:Name="PreferredDisplayCombo" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="Which display to record." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="CaptureApplicationField" Grid.Column="2" ColumnDefinitions="48,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Width="48" Height="54" CornerRadius="10" Background="#2B3138" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="Application (optional)" FontSize="13" FontWeight="SemiBold" />
                                            <ComboBox x:Name="PreferredApplicationCombo" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="Record a specific application instead." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="13">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Behaviour" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Control when capture starts and how ClipDat behaves." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                        <Border Background="#22282F" CornerRadius="9" Padding="6">
                                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                                <Border Width="44" Height="44" CornerRadius="9" Background="#2B3138">
                                                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Start capture when ClipDat opens" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="Begin recording automatically" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleButton x:Name="AutoCaptureCheck" Grid.Column="2" Style="{StaticResource BehaviourToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="Start capture when ClipDat opens" />
                                            </Grid>
                                        </Border>
                                        <Border Background="#22282F" Grid.Row="1" CornerRadius="9" Padding="6">
                                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                                <Border Width="44" Height="44" CornerRadius="9" Background="#2B3138">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 4,3 L 18,3 Q 21,3 21,6 L 21,18 Q 21,21 18,21 L 4,21 Q 1,21 1,18 L 1,6 Q 1,3 4,3 Z M 7,12 L 16,12 M 13,9 L 16,12 L 13,15" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Start ClipDat when I sign in" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="Launch automatically with Windows" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleButton x:Name="StartWithWindowsCheck" Grid.Column="2" Style="{StaticResource BehaviourToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="Start ClipDat when I sign in" />
                                            </Grid>
                                        </Border>
                                    <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Background="#39424B" Margin="0,4" />
                                        <Border Grid.Column="2" Background="#22282F" CornerRadius="9" Padding="6">
                                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                                <Border Width="44" Height="44" CornerRadius="9" Background="#2B3138">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 4,4 L 18,4 Q 20,4 20,6 L 20,18 Q 20,20 18,20 L 4,20 Q 2,20 2,18 L 2,6 Q 2,4 4,4 Z M 7,12 L 15,12" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Minimize to notification area" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="Keep running in the background" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleButton x:Name="MinimizeToTrayCheck" Grid.Column="2" Style="{StaticResource BehaviourToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="Minimize ClipDat to the notification area when closing" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Grid.Row="1" Background="#22282F" CornerRadius="9" Padding="6">
                                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                                <Border Width="44" Height="44" CornerRadius="9" Background="#2B3138">
                                                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 2,11 C 7,3 17,3 22,11 C 19,16 14,18 9,17 M 4,18 L 20,4 M 10,10 C 10,13 13,15 16,13" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="Keep capture running while hidden" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="Continue recording when minimized" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleButton x:Name="KeepCaptureRunningWhileHiddenCheck" Grid.Column="2" Style="{StaticResource BehaviourToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="Keep capture running while hidden" />
                                            </Grid>
                                        </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Storage" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Manage disk space and automatic behaviour." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#2B3138" VerticalAlignment="Top">
                                            <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 3,5 C 3,2 21,2 21,5 C 21,8 3,8 3,5 Z M 3,5 L 3,19 C 3,22 21,22 21,19 L 21,5 M 3,12 C 3,15 21,15 21,12" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="Minimum free disk space" VerticalAlignment="Center" />
                                                <ComboBox x:Name="MinimumFreeSpaceCombo" Grid.Column="1" MinWidth="115" HorizontalAlignment="Stretch" />
                                            </Grid>
                                            <TextBlock Text="Pause capture and warn when free space falls below this amount." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Width="1" Background="#39424B" Margin="0,4" />
                                    <Grid Grid.Column="2" ColumnDefinitions="48,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="10" Background="#2B3138" VerticalAlignment="Top">
                                            <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 3,5 C 3,2 21,2 21,5 C 21,8 3,8 3,5 Z M 3,5 L 3,19 C 3,22 21,22 21,19 L 21,5 M 3,12 C 3,15 21,15 21,12" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Recording health" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse x:Name="ReliabilityHealthDot" Width="7" Height="7" Fill="#7B8793" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ReliabilityHealthStatus" Text="Checking capture and storage…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock x:Name="ReliabilityHealthText" Text="Checking available space…" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="AppStorageText" Text="ClipDat app files and data: calculating…" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdvancedPreviewDiagnosticsCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                <Border Width="48" Height="48" CornerRadius="10" Background="#2B3138">
                                    <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Preview" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose what information is shown in the capture preview." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="FPS, dropped frames, memory usage, encoder timing and hotkeys." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowPreviewDiagnosticsCheck" Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Show performance details in preview" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="13">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Recording" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose recording quality and output detail." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Resolution" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ResolutionCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Frame rate" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="FrameRateCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid x:Name="AdvancedEncoderRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Video encoder" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <ComboBox x:Name="EncoderCombo" MinWidth="260" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Hardware uses the GPU; software uses the CPU. Automatic tries hardware first. Changes reset the replay buffer." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Resolution and frame rate changes apply to the next recording. Stop the current recording first." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="VoicePage" Grid.Row="1" Margin="24,20,8,14" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Width="58" Height="58" CornerRadius="14" Background="#263C55" BorderBrush="#3F6589" BorderThickness="1" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Voice commands" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="Control ClipDat with on-device Windows speech recognition." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="12,8" VerticalAlignment="Center" MaxWidth="220">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="Enabled" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="VoiceCommandsCheck" Grid.Column="1" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" AutomationProperties.Name="Enable local voice commands" />
                                    </Grid>
                                    <TextBlock x:Name="VoiceSettingsStatus" Text="Voice commands are off." FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="16">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Live transcriber" FontSize="17" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse x:Name="VoiceListeningDot" Width="8" Height="8" Fill="#7B8793" />
                                                <TextBlock x:Name="VoiceListeningLabel" Text="Not listening" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#1D2228" BorderBrush="#39424B" BorderThickness="1" CornerRadius="8" Padding="14,12" MinHeight="122">
                                            <StackPanel Spacing="14">
                                                <TextBlock x:Name="VoiceTranscriptText" Text="Say a command to test recognition." FontSize="17" TextWrapping="Wrap" />
                                                <Border BorderBrush="#303A44" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                    <TextBlock x:Name="VoiceTranscriptResultText" Text="Waiting for speech" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Shows live command hypotheses and the last recognised phrase while listening. It does not transcribe unrestricted speech."
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Quick settings" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Optional wake phrase" />
                                                <TextBlock Text="Say this before a command" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBox x:Name="VoiceWakePhraseBox" Grid.Column="1" Width="155" PlaceholderText="Off · or ClipDat" MaxLength="32" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Minimum confidence" />
                                                <TextBlock Text="Ignore uncertain matches" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ComboBox x:Name="VoiceConfidenceCombo" Grid.Column="1" Width="190" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Command cooldown" />
                                                <TextBlock Text="Prevent repeated triggers" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <NumberBox x:Name="VoiceCooldownBox" Grid.Column="1" Width="155" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" VerticalAlignment="Stretch">
                                <StackPanel Spacing="11">
