<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Clippr.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="VoiceCommandRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#242B32" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="VoiceCommandGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#20262D" />
            <Setter Property="BorderBrush" Value="#39424B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="VoicePhraseEditorStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="ContentElement" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" IsTabStop="False" />
                            <Border Height="1" Background="#2E98F0" VerticalAlignment="Bottom" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left" OpenPaneLength="225" CompactPaneLength="48" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="OnNavigationSelectionChanged"
                    Background="#21252A" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,18,12,20" Spacing="3">
                <TextBlock Text="ClipDat" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="SETTINGS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Capture" Tag="Capture">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Voice Control" Tag="Voice">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Audio" Tag="Audio">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Output" Tag="Output">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE74E;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Feedback" Tag="Feedback">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Border Height="68">
                <Grid>
                    <StackPanel Margin="20,6,12,4" Spacing="2">
                        <TextBlock Text="Advanced settings" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch x:Name="AdvancedToggle" OnContent="" OffContent="" HorizontalAlignment="Left"
                                      Toggled="OnAdvancedToggled" AutomationProperties.Name="Show advanced settings" />
                    </StackPanel>
                    <Border Height="1" Margin="0,10,0,0" VerticalAlignment="Top"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </Grid>
            </Border>
        </NavigationView.PaneFooter>
        <NavigationView.Content>
            <Grid x:Name="SettingsPages" RowDefinitions="*,Auto">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#242A30" Offset="0" />
                        <GradientStop Color="#1E2023" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <ScrollViewer x:Name="CapturePage" Grid.Row="0" Margin="28,24,28,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="3" Margin="0,0,0,2">
                            <TextBlock Text="Capture" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Choose what ClipDat captures and how recordings are encoded." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="13">
                                <TextBlock Text="Capture source" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Capture mode" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="CaptureModeCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Preferred display" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="PreferredDisplayCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Preferred application" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="PreferredApplicationCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Start capture when ClipDat opens" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="AutoCaptureCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Start capture when ClipDat opens" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Minimize to notification area when closing" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="MinimizeToTrayCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Minimize ClipDat to the notification area when closing" />
                                </Grid>
                                <TextBlock Text="ClipDat keeps capture running while hidden. Choose Exit ClipDat from the tray menu to stop capture and quit." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid x:Name="AdvancedStartupRow" ColumnDefinitions="*,Auto" MinHeight="42" Visibility="Collapsed">
                                    <TextBlock Text="Start ClipDat when I sign in" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="StartWithWindowsCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Start ClipDat when I sign in" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Minimum free disk space" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="MinimumFreeSpaceCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="ClipDat pauses disk-backed replay buffering and warns before saves when either the replay spool or clip drive reaches this reserve." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recording health" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="ReliabilityHealthText" Text="Checking capture and storage health…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="ReliabilityErrorsText" Text="No recent errors." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Technical errors are logged locally with a rotating size limit. Logs are never uploaded." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid x:Name="AdvancedPreviewDiagnosticsRow" ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="Collapsed" Margin="0,8,0,0">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Show performance details in preview" />
                                        <TextBlock Text="FPS, dropped frames, replay memory, encoder timing and hotkeys." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ShowPreviewDiagnosticsCheck" Grid.Column="1" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" AutomationProperties.Name="Show performance details in preview" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="13">
                                <TextBlock Text="Recording" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Resolution" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ResolutionCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Frame rate" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="FrameRateCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid x:Name="AdvancedEncoderRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Video encoder" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <ComboBox x:Name="EncoderCombo" IsEnabled="False" MinWidth="260" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Media Foundation hardware availability is checked when recording starts." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Resolution and frame rate changes apply to the next recording. Stop the current recording first." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="VoicePage" Grid.Row="0" Margin="24,20,8,14" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Width="58" Height="58" CornerRadius="14" Background="#263C55" BorderBrush="#3F6589" BorderThickness="1" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Voice commands" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="Control ClipDat with on-device Windows speech recognition." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="12,8" VerticalAlignment="Center" MaxWidth="220">
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="Enabled" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="VoiceCommandsCheck" Grid.Column="1" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" AutomationProperties.Name="Enable local voice commands" />
                                    </Grid>
                                    <TextBlock x:Name="VoiceSettingsStatus" Text="Voice commands are off." FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="16">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Live transcriber" FontSize="17" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse x:Name="VoiceListeningDot" Width="8" Height="8" Fill="#7B8793" />
                                                <TextBlock x:Name="VoiceListeningLabel" Text="Not listening" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#1D2228" BorderBrush="#39424B" BorderThickness="1" CornerRadius="8" Padding="14,12" MinHeight="122">
                                            <StackPanel Spacing="14">
                                                <TextBlock x:Name="VoiceTranscriptText" Text="Say a command to test recognition." FontSize="17" TextWrapping="Wrap" />
                                                <Border BorderBrush="#303A44" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                    <TextBlock x:Name="VoiceTranscriptResultText" Text="Waiting for speech" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Shows live command hypotheses and the last recognised phrase while listening. It does not transcribe unrestricted speech."
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Quick settings" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Optional wake phrase" />
                                                <TextBlock Text="Say this before a command" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBox x:Name="VoiceWakePhraseBox" Grid.Column="1" Width="155" PlaceholderText="Off · or ClipDat" MaxLength="32" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Minimum confidence" />
                                                <TextBlock Text="Ignore uncertain matches" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ComboBox x:Name="VoiceConfidenceCombo" Grid.Column="1" Width="155" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Command cooldown" />
                                                <TextBlock Text="Prevent repeated triggers" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <NumberBox x:Name="VoiceCooldownBox" Grid.Column="1" Width="155" Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="11">
                                    <TextBlock Text="Available commands" FontSize="17" FontWeight="SemiBold" />
                                    <TextBox x:Name="VoiceCommandSearchBox" PlaceholderText="Search commands…" AutomationProperties.Name="Search voice commands" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button x:Name="VoiceFilterAllButton" Content="All" Click="OnVoiceFilterClick" Tag="All" FontSize="11" Padding="10,4" CornerRadius="12" />
                                        <Button x:Name="VoiceFilterClippingButton" Content="Clipping" Click="OnVoiceFilterClick" Tag="Clipping" FontSize="11" Padding="10,4" CornerRadius="12" />
                                        <Button x:Name="VoiceFilterRecordingButton" Content="Recording" Click="OnVoiceFilterClick" Tag="Recording" FontSize="11" Padding="10,4" CornerRadius="12" />
                                        <Button x:Name="VoiceFilterGeneralButton" Content="Other" Click="OnVoiceFilterClick" Tag="General" FontSize="11" Padding="10,4" CornerRadius="12" />
                                    </StackPanel>
                                    <StackPanel x:Name="VoiceCommandList" Spacing="7" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <TextBlock Text="Voice Control uses the current Windows default microphone and an installed offline speech language. Your recording input selection stays independent. No microphone audio or transcript is saved."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AudioPage" Grid.Row="0" Margin="28,24,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="3" Margin="0,0,0,2">
                            <TextBlock Text="Audio" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Choose real WASAPI devices and independent sources for your clips." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Desktop audio" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Capture desktop output" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="DesktopAudioCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Capture desktop output" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Output device" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="OutputDeviceCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Microphone" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Capture microphone" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="MicrophoneCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Capture microphone" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Input device" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="InputDeviceCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AdvancedApplicationAudioCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Application audio" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Game audio" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="GameAudioCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Discord audio" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="DiscordAudioCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="Selected sources are saved on separate tracks. Process audio replaces the desktop mix to avoid duplicates." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Windows process loopback needs Windows 10 build 20348 or newer." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="OutputPage" Grid.Row="0" Margin="28,24,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="3" Margin="0,0,0,2">
                            <TextBlock Text="Output" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Set replay duration, file type, quality and save location." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Replay clips" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Clip length" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ClipLengthCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid x:Name="CustomLengthRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Custom duration (seconds)" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <NumberBox x:Name="CustomLengthBox" Grid.Column="1" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                                </Grid>
                                <Grid x:Name="AdvancedReplayMemoryRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Replay memory limit" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ReplayMemoryCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Quality preset" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="QualityCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Video format" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="VideoFormatCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="This format is used for Save Clip replay exports. Direct recordings use MP4." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Clip folder" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="ClipFolderBox" MinWidth="180" />
                                        <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolderClick" />
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Play a sound after a clip is saved" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="NotificationSoundCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Play a sound after a clip is saved" />
                                </Grid>
                                <Grid x:Name="AdvancedNotificationRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Notification style" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <ComboBox x:Name="NotificationStyleCombo" MinWidth="260" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Show a notification when ClipDat is ready to clip and after a clip is saved."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="Preview notification" HorizontalAlignment="Left" Click="OnPreviewNotificationClick" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="AdvancedHotkeyRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="Global clipping hotkey" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="HotkeyCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="Screenshots" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Image format" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ScreenshotFormatCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Grid x:Name="ScreenshotJpegQualityRow" ColumnDefinitions="190,*" ColumnSpacing="16" Visibility="Collapsed">
                                    <TextBlock Text="JPEG quality" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <NumberBox x:Name="ScreenshotJpegQualityBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Copy screenshot to clipboard" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="CopyScreenshotCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Copy screenshot to clipboard" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" MinHeight="42">
                                    <TextBlock Text="Play a sound after a screenshot is saved" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="ScreenshotSoundCheck" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Play a sound after a screenshot is saved" />
                                </Grid>
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Screenshot hotkey" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ScreenshotHotkeyCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="FeedbackPage" Grid.Row="0" Margin="28,24,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="3" Margin="0,0,0,2">
                            <TextBlock Text="Feedback" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="ClipDat build details and diagnostic information." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="About ClipDat" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="190,*" ColumnSpacing="16">
                                    <TextBlock Text="Application version" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="AdvancedFeedbackActions" Spacing="10" Visibility="Collapsed">
                                    <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostic information" HorizontalAlignment="Left" Click="OnCopyDiagnosticsClick" />
                                    <Button x:Name="OpenFeedbackButton" Content="Open feedback page" HorizontalAlignment="Left" Click="OnOpenFeedbackClick" Visibility="Collapsed" />
                                    <TextBlock x:Name="FeedbackUrlMessage" Text="No feedback URL is configured for this build." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="FeedbackMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Background="#252A30" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" Padding="24,10,28,12" MinHeight="68">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock x:Name="SettingsStatus" Text="Settings loaded · press Save changes to apply." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="Save changes" Style="{StaticResource AccentButtonStyle}" Click="OnSaveSettingsClick" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</UserControl>
